# AI Employee Silver Tier - Environment Variables

# Vault Configuration
VAULT_PATH=./ai_employee_vault
WATCH_FOLDER=./ai_employee_vault/Inbox

# Logging
LOG_LEVEL=INFO

# LinkedIn API Configuration (Required for LinkedIn posting)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# Gmail Configuration (Optional - for Gmail watcher)
GMAIL_EMAIL=your_email@gmail.com
GMAIL_PASSWORD=your_app_password_here

# Scheduling (Optional)
POLL_INTERVAL=60
MAX_ITERATIONS=10

# Note: Copy this file to .env and fill in your actual credentials
# Never commit .env to version control
